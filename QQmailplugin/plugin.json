{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "qq-mail",
  "version": "0.4.4",
  "description": "Local Windows QQ Mail tools with native confirmation and bounded task authorizations.",
  "author": {
    "name": "Codex Local"
  },
  "repository": "https://github.com/moondream69/QQmail-plugin",
  "keywords": [
    "qq-mail",
    "email",
    "imap",
    "smtp"
  ],
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "QQ 邮箱",
        "shortDescription": "本地邮箱工具，支持原生确认与有限任务授权",
        "capabilities": [
          "Interactive",
          "Read",
          "Write"
        ]
      }
    }
  }
}

{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "qq-mail",
  "version": "0.4.0",
  "description": "Local Windows QQ Mail integration with explicit native sending approval.",
  "author": {
    "name": "FredericaBernkastel1"
  },
  "repository": "https://github.com/FredericaBernkastel1/QQmail-plugin",
  "keywords": [
    "qq-mail",
    "email",
    "imap",
    "smtp"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "QQ 邮箱",
        "shortDescription": "本地读取、搜索和管理邮件，发送前由用户在 Windows 窗口确认。",
        "capabilities": [
          "Interactive",
          "Read",
          "Write"
        ]
      }
    }
  }
}
